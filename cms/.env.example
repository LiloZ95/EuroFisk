# ─── Database ──────────────────────────────────────────────────────────────
# Neon Postgres. Create a project at neon.tech, copy the pooled connection string.
DATABASE_URI=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/eurofisk?sslmode=require

# ─── Payload ───────────────────────────────────────────────────────────────
# Any long random string. Generate with: openssl rand -base64 32
# Changing this logs everyone out.
PAYLOAD_SECRET=

# ─── Cloudflare R2 (image storage) ─────────────────────────────────────────
# Cloudflare dashboard → R2 → create bucket, then "Manage R2 API Tokens".
R2_BUCKET=eurofisk-media
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public URL. Enable "Public Development URL" on the bucket, or bind a
# custom domain like https://media.eurofisk.se (recommended for production).
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ─── Misc ──────────────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser. The public site fetches at build time
# (server-side), so this only needs the CMS's own URL.
CORS_ORIGINS=http://localhost:3000
