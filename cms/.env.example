# ─── Database ──────────────────────────────────────────────────────────────
# Neon Postgres. Create a project at neon.tech, copy the *pooled* connection string —
# the host contains "-pooler". Serverless opens a connection per invocation and the
# direct (non-pooled) host runs out of connections under the admin panel's traffic.
DATABASE_URI=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/eurofisk?sslmode=require

# ─── Payload ───────────────────────────────────────────────────────────────
# Any long random string. Generate with: openssl rand -base64 32
# Changing this logs everyone out.
PAYLOAD_SECRET=

# ─── Cloudflare R2 (image storage) ─────────────────────────────────────────
# Cloudflare dashboard → R2 → create bucket, then "Manage R2 API Tokens".
R2_BUCKET=eurofisk-media
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public URL. Enable "Public Development URL" on the bucket, or bind a
# custom domain like https://media.eurofisk.se (required for production — Cloudflare
# rate-limits the pub-*.r2.dev URL and says not to use it for live traffic).
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ─── Rebuild trigger ───────────────────────────────────────────────────────
# After a save, the CMS asks GitHub to rebuild the public site. Leave both unset locally
# so editing and seeding do not fire real deploys; set them on the deployment.
#
# GITHUB_REPO is "owner/repository".
# GITHUB_DISPATCH_TOKEN is a fine-grained personal access token scoped to this one repo
# with the "Contents: read and write" permission, which is what allows repository_dispatch.
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=

# ─── Misc ──────────────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser. The public site fetches at build time
# (server-side), so this only needs the CMS's own URL — but it must be the deployed URL
# once hosted, or the admin panel cannot talk to its own API.
CORS_ORIGINS=http://localhost:3000
